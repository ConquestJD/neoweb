RewriteEngine On

# Serve robots.txt directly
RewriteRule ^robots\.txt$ robots.txt [L]

# Serve sitemap.xml directly  
RewriteRule ^sitemap\.xml$ sitemap.xml [L]

# Serve favicon as logo.ico
RewriteRule ^favicon\.ico$ logo.ico [L]
RewriteRule ^logo\.ico$ logo.ico [L]

# Serve assets directory directly
RewriteRule ^assets/ - [L]

# Everything else goes to index.html for Angular routing
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
